# Backend Worker
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/agentflow?sslmode=require"
GHL_WEBHOOK_SECRET="replace-with-ghl-webhook-signing-secret"
GHL_API_TOKEN="replace-with-private-integrations-token-for-on-demand-contact-details"
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
GHL_CLIENT_ID="6a035ee24b80374d79d8c5c0-mp2xo4p3"
GHL_CLIENT_SECRET="replace-with-marketplace-app-client-secret"
GHL_APP_ID="replace-with-marketplace-app-id-optional"
GHL_INSTALL_URL="https://marketplace.gohighlevel.com/v2/oauth/chooselocation?response_type=code&client_id=6a035ee24b80374d79d8c5c0-mp2xo4p3&version_id=6a6a3c701a53bd484390b873"
# Optional: paste the full Installation URL from Developer Portal → your app → Advanced Settings → Auth → Show installation URL.
# When set, it is preferred over GHL_INSTALL_URL (same OAuth screen you use in the iframe, without hand-assembling query params).
GHL_OAUTH_START_URL="https://marketplace.gohighlevel.com/v2/oauth/chooselocation?response_type=code&redirect_uri=https%3A%2F%2Fapi.agentflow.autowiz.net%2Foauth%2Fgohighlevel%2Fcallback&client_id=6a035ee24b80374d79d8c5c0-mp2xo4p3&scope=contacts.readonly+conversations.readonly+conversations.write+conversations%2Fmessage.readonly+conversations%2Fmessage.write+conversations%2Freports.readonly+conversations%2Flivechat.write+locations.readonly+locations%2Ftags.readonly+locations%2Ftags.write+locations%2FcustomValues.readonly+oauth.write+oauth.readonly+invoices.readonly+invoices%2Fschedule.readonly+payments%2Forders.readonly+payments%2Forders.collectPayment+payments%2Fintegration.readonly+payments%2Ftransactions.readonly+payments%2Fsubscriptions.readonly+payments%2Fcoupons.readonly+payments%2Fcustom-provider.readonly+opportunities.readonly+opportunities.write+calendars.readonly+calendars%2Fevents.readonly+calendars%2Fgroups.readonly+calendars%2Fresources.readonly&version_id=6a6a3c701a53bd484390b873"
# Optional: if version_id is omitted from GHL_INSTALL_URL, set it here (same uuid as Marketplace app version).
GHL_VERSION_ID="6a6a3c701a53bd484390b873"
# Optional: override default Marketplace OAuth scopes (space-separated).
GHL_OAUTH_SCOPE=""
GHL_OAUTH_REDIRECT_URI="https://api.agentflow.autowiz.net/oauth/gohighlevel/callback"
GHL_OAUTH_USER_TYPE="Company"
GHL_DEFAULT_WEBHOOK_URL="https://api.agentflow.autowiz.net/webhooks/gohighlevel"
# Stripe Connect (Client Charges — link acct_… per subaccount; direct charge on connected account; sk_test first).
STRIPE_SECRET_KEY="sk_test_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"
# Client Charges: only "true" allows POST /workspace/client-charges/.../charge (sync unchanged).
CLIENT_CHARGES_CHARGING_ENABLED="false"
FRONTEND_BASE_URL="https://agentflow.autowiz.net"

# Workspace UI auth (JWT on API). Leave JWT_SECRET unset to keep legacy x-viewer-key mode only.
JWT_SECRET=""

# Optional Workers cron (mirror values in Dashboard / wrangler vars):
# Drain blank location display names — each cron tick hydrates up to min(parseInt,LOCATION_NAME_CRON_BATCH),15 unnamed rows:
# LOCATION_NAME_CRON_BATCH=0
# Re-fetch labels for stale named rows — cap min(parseInt,LOCATION_NAMES_REFRESH_BATCH),15 lookups per tick; needs migration 0010:
# LOCATION_NAMES_REFRESH_BATCH=0
# LOCATION_NAMES_REFRESH_STALE_AFTER_DAYS=2
# LOCATION_NAMES_REFRESH_HOUR_UTC=

# Frontend Pages
# Cloudflare Worker API origin (must NOT be the Pages app URL or a GCS bucket).
NEXT_PUBLIC_API_BASE_URL="https://agentflow-api.example.workers.dev"

NEXT_PUBLIC_GHL_CLIENT_ID="6a035ee24b80374d79d8c5c0-mp2xo4p3"
NEXT_PUBLIC_GHL_VERSION_ID="6a6a3c701a53bd484390b873"
NEXT_PUBLIC_GHL_INSTALL_URL=""
